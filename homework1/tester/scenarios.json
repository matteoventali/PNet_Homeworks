    "scenario_2_asymmetric_load": {
      "description": "Simulates a production cluster where a massive background job (e.g., LLM training with 16 workers) runs alongside small, frequent, and short-burst jobs. Tests max-min fairness to prevent light jobs from starvation.",
      "trainings": [
        {"name": "blue",   "senders": ["w1","w2","w3","w4","w5","w6","w7","w8","w9","w10","w11","w12","w13","w14","w15","w16"], "collector": "c1", "collector_ip": "10.0.1.1", "D": 150.0, "T": 60, "phi": 1.0, "cycles": 2},
        {"name": "green",  "senders": ["w17","w18","w19","w20"], "collector": "c2", "collector_ip": "10.0.1.2", "D": 30.0, "T": 20, "phi": 5.0, "cycles": 5},
        {"name": "red",    "senders": ["w21","w22","w23","w24"], "collector": "c3", "collector_ip": "10.0.1.3", "D": 30.0, "T": 20, "phi": 10.0, "cycles": 5},
        {"name": "yellow", "senders": ["w25","w26","w27","w28"], "collector": "c4", "collector_ip": "10.0.1.4", "D": 30.0, "T": 20, "phi": 15.0, "cycles": 5}
      ]
