    "scenario_3_stochastic_cascade": {
      "description": "Creates a continuous, staggered flow of distributed training cycles. Phase offsets (phi) are carefully shifted so that network buffers are constantly utilized, evaluating the controller's dynamic path re-allocation stability over time.",
      "trainings": [
        {"name": "blue",   "senders": ["w1","w2","w3","w4","w5","w6","w7"], "collector": "c1", "collector_ip": "10.0.1.1", "D": 70.0, "T": 25, "phi": 0.0, "cycles": 5},
        {"name": "green",  "senders": ["w8","w9","w10","w11","w12","w13","w14"], "collector": "c2", "collector_ip": "10.0.1.2", "D": 70.0, "T": 25, "phi": 6.0, "cycles": 5},
        {"name": "red",    "senders": ["w15","w16","w17","w18","w19","w20","w21"], "collector": "c3", "collector_ip": "10.0.1.3", "D": 70.0, "T": 25, "phi": 12.0, "cycles": 5},
