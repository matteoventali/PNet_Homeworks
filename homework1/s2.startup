ip addr add 20.0.1.7/24 dev eth5

tc qdisc add dev eth0 root handle 1: netem delay 0.5ms
tc qdisc add dev eth0 parent 1: handle 2: tbf rate 100mbit burst 50000 limit 62500

tc qdisc add dev eth1 root handle 1: netem delay 0.5ms
tc qdisc add dev eth1 parent 1: handle 2: tbf rate 100mbit burst 50000 limit 62500

tc qdisc add dev eth2 root handle 1: netem delay 0.5ms
tc qdisc add dev eth2 parent 1: handle 2: tbf rate 100mbit burst 50000 limit 62500

tc qdisc add dev eth3 root handle 1: netem delay 0.5ms
tc qdisc add dev eth3 parent 1: handle 2: tbf rate 100mbit burst 50000 limit 62500

tc qdisc add dev eth4 root handle 1: netem delay 0.5ms
tc qdisc add dev eth4 parent 1: handle 2: tbf rate 100mbit burst 50000 limit 62500

/usr/share/openvswitch/scripts/ovs-ctl --system-id=random start
ovs-vsctl add-br s2
ovs-vsctl set Bridge s2 other-config:datapath-id=0000000000000007
ovs-vsctl add-port s2 eth0
ovs-vsctl add-port s2 eth1
ovs-vsctl add-port s2 eth2
ovs-vsctl add-port s2 eth3
ovs-vsctl add-port s2 eth4

ovs-vsctl set interface eth0 ingress_policing_rate=100000
ovs-vsctl set interface eth0 ingress_policing_burst=10000
ovs-vsctl set interface eth1 ingress_policing_rate=100000
ovs-vsctl set interface eth1 ingress_policing_burst=10000
ovs-vsctl set interface eth2 ingress_policing_rate=100000
ovs-vsctl set interface eth2 ingress_policing_burst=10000
ovs-vsctl set interface eth3 ingress_policing_rate=100000
ovs-vsctl set interface eth3 ingress_policing_burst=10000
ovs-vsctl set interface eth4 ingress_policing_rate=100000
ovs-vsctl set interface eth4 ingress_policing_burst=10000

ovs-vsctl set-controller s2 tcp:20.0.1.100