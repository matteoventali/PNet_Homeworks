ip addr add 192.168.13.3/24 dev eth0
ip link set dev eth0 up
ip addr add 192.168.23.3/24 dev eth1
ip link set dev eth1 up
ip addr add 192.168.35.3/24 dev eth2
ip link set dev eth2 up
ip addr add 192.168.37.3/24 dev eth3
ip link set dev eth3 up

# Shortest path route for return traffic to h1 and h2 (via A)
ip route add 10.0.1.0/24 via 192.168.13.1
ip route add 10.0.2.0/24 via 192.168.13.1
