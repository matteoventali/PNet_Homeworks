ip addr add 192.168.68.8/24 dev eth0
ip link set dev eth0 up
ip addr add 192.168.78.8/24 dev eth1
ip link set dev eth1 up
ip addr add 10.0.3.1/24 dev eth2
ip link set dev eth2 up
ip addr add 10.0.4.1/24 dev eth3
ip link set dev eth3 up

# Route return traffic toward h1 via F and h2 via G (Shortest Paths)
ip route add 10.0.1.0/24 via 192.168.68.6
ip route add 10.0.2.0/24 via 192.168.78.7
